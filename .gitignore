.DS_Store
Thumbs.db

# secrets — never commit
infra/.session-secret
infra/.shared-secret
infra/.page-credentials

# Build artifacts. dist/cf-session-gate.js carries the session signing keys and
# dist/.tmp holds scratch policy documents, so this MUST stay ignored.
# NB: keep comments on their own line — a trailing "# ..." after a pattern is
# treated as part of the pattern, which silently un-ignores it.
dist/
infra/lambda/function.zip
infra/lambda/node_modules

# source material — contains vendor/commercial detail kept off the page
source/
*.mhtml

# sandbox sender address (environment-specific, not a secret)
infra/.sender
